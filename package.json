{
  "name": "route-progress-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MONTHLY=1 npm run build:routes && vite",
    "build": "npm run build:routes && npm run build:app",
    "build:app": "vite build",
    "build:routes": "node scripts/build-routes.mjs",
    "build:basemap": "node scripts/fetch-basemap.mjs",
    "render:all": "node scripts/render-instagram.mjs",
    "render:last-month": "MONTHLY=1 node scripts/render-instagram.mjs",
    "render:each-month": "node scripts/render-each-month.mjs",
    "render:draft": "FPS=15 OUTPUT=exports/draft-route-map.mp4 npm run render:all"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "maplibre-gl": "^6.1.0",
    "pmtiles": "^4.4.1",
    "protomaps-themes-base": "^4.5.0",
    "vite": "^8.0.10"
  }
}
